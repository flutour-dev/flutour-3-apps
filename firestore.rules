// Firestore Security Rules — FluTour
// TODO: Deploy to all 3 Firebase projects when Google account is recovered
// Deploy command: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'super-admin'];
    }

    function isApprovedDriver() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.status == 'approved';
    }

    // ── users collection ────────────────────────────────────────────────────
    // Profile: {name, phone, role:'passenger', createdAt, totalRides}
    match /users/{uid} {
      // Passenger can read/write their own profile
      allow read, write: if isOwner(uid);
      // Admin can read all user profiles
      allow read: if isAdmin();
      // Only allow role field to be set to 'passenger' on create (not admin)
      allow create: if isOwner(uid) && request.resource.data.role == 'passenger';
    }

    // ── drivers collection ──────────────────────────────────────────────────
    // Profile: {name, phone, vehicleId, vehicleType, status:'pending'|'approved'|'rejected',
    //           rating, totalTrips, earnings, createdAt}
    match /drivers/{uid} {
      // Any signed-in user (passenger) can read driver profiles for vehicle selection
      allow read: if isSignedIn();
      // Driver can update their own profile (except status and role)
      allow update: if isOwner(uid) &&
        !('status' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('role' in request.resource.data.diff(resource.data).affectedKeys());
      // Driver can create their own profile with status = 'pending'
      allow create: if isOwner(uid) && request.resource.data.status == 'pending';
      // Only admin can approve/reject drivers
      allow write: if isAdmin();
    }

    // ── trips collection ────────────────────────────────────────────────────
    // Trip: {passengerId, driverId, status, pickup, dropoff, fare, createdAt, ...}
    match /trips/{tripId} {
      // Any signed-in user can list/query trips (driver needs this to find ride requests)
      // Individual document security is enforced by the get rule below
      allow list: if isSignedIn();
      // Passenger reads their own trip; driver reads requested or assigned trips
      allow get: if isSignedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'requested'
      );
      // Passenger can create a trip
      allow create: if isSignedIn() && request.resource.data.passengerId == request.auth.uid;
      // Driver can accept an unassigned requested trip (driverId may be '' or missing)
      allow update: if isSignedIn() && resource.data.status == 'requested' &&
        (resource.data.driverId == '' || resource.data.driverId == null);
      // Driver can update their own assigned trip (arrive, start, complete, rate)
      allow update: if isSignedIn() && resource.data.driverId == request.auth.uid;
      // Passenger can cancel or update their own trip (counter-offer, rating)
      allow update: if isSignedIn() && resource.data.passengerId == request.auth.uid;
      // Admin can read/write all trips
      allow read, write: if isAdmin();

      // ── messages subcollection (in-trip chat) ──────────────────────────────
      match /messages/{messageId} {
        // Passenger and driver involved in this trip can read and send messages
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == request.auth.uid
        );
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == request.auth.uid
        );
      }

      // ── offers subcollection (InDrive-style driver fare bidding) ──────────
      match /offers/{driverUid} {
        // Passenger can read all offers on their trip
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == request.auth.uid;
        // Driver can read their own offer
        allow read: if isSignedIn() && request.auth.uid == driverUid;
        // Driver can write their own offer
        allow create, update: if isSignedIn() && request.auth.uid == driverUid;
        // Admin can read/write all offers
        allow read, write: if isAdmin();
      }
    }

    // ── payments collection ─────────────────────────────────────────────────
    // Payment: {tripId, passengerId, driverId, amount, method, status, createdAt}
    match /payments/{paymentId} {
      allow read: if isSignedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.passengerId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ── notifications collection ────────────────────────────────────────────
    // Notification: {userId, title, body, read, createdAt}
    match /notifications/{notifId} {
      allow read, write: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // ── settings collection ─────────────────────────────────────────────────
    // admin instapay, surge multipliers, app config
    match /settings/{docId} {
      // Any signed-in user can read (driver needs admin instapay, surge rates)
      allow read: if isSignedIn();
      // Only admin can write
      allow write: if isAdmin();
    }

    // ── withdrawal_requests collection ──────────────────────────────────────
    // Request: {driverId, driverName, driverPhone, amount, status, requestedAt}
    match /withdrawal_requests/{reqId} {
      // Driver can create their own withdrawal request
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      // Driver can read their own requests
      allow read: if isSignedIn() && resource.data.driverId == request.auth.uid;
      // Admin can read/write all withdrawal requests
      allow read, write: if isAdmin();
    }

  }
}
