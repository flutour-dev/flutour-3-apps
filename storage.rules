rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Driver profile photos — uploaded during registration or profile editing
    match /driver_photos/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Driver license photos — uploaded during registration
    match /driver_licenses/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Vehicle photos — uploaded during registration or profile editing
    match /vehicle_photos/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Passenger profile photos — uploaded from the profile tab
    match /profile_photos/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
